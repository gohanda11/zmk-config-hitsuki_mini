#include <behaviors/ws2812_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE      0
#define MOUSE     1
#define FUNCTION  2
#define NUM       3
#define ARROW     4
#define SCROLL    5
#define ADJUST    6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&sl { release-after-ms = <250>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <FUNCTION NUM>;
            then-layer = <ADJUST>;
        };
    };
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANGUAGE_2>, <&mo FUNCTION>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANGUAGE_1>, <&mo NUM>, <&mo MOUSE>;
        };

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "SandS";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
            layers = <MOUSE>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;
            label = "MKP_EXIT_AML";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "Base";
            bindings = <
&kp GRAVE       &kp N1         &kp N2         &kp N3               &kp N4             &kp N5        &kp N6                &kp N7                &kp N8                &kp N9                 &kp N0                &kp BACKSLASH
&kp ESCAPE      &kp Q          &kp W          &kp E                &kp R              &kp T         &kp Y                 &kp U                 &kp I                 &kp O                  &kp P                 &kp BACKSPACE
&mt LCTRL TAB   &kp A          &kp S          &kp D                &kp F              &kp G         &kp LEFT_BRACE        &kp RIGHT_BRACE       &kp H                 &kp J                  &kp K                 &kp L                &lt SCROLL MINUS      &kp EQUAL
&kp LEFT_SHIFT  &kp Z          &kp X          &kp C                &kp V              &kp B         &kp LEFT_BRACKET      &kp RIGHT_BRACKET     &kp N                 &kp M                  &kp COMMA             &kp PERIOD           &kp SLASH             &kp RSHFT
&kp LEFT_WIN    &kp LEFT_ALT   &lt ADJUST DELETE  &SandS LSHFT SPACE  &mo FUNCTION   &mo ARROW     &td0                  &td1                  &mo MOUSE             &lt FUNCTION ENTER     &mt RSHIFT BACKSPACE  &kp SEMICOLON        &lt ADJUST SINGLE_QUOTE  &kp RIGHT_ALT
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&to_layer_0 GRAVE  &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5    &to_layer_0 N6    &to_layer_0 N7    &to_layer_0 N8    &to_layer_0 N9  &to_layer_0 N0  &to_layer_0 BACKSLASH
&to_layer_0 ESCAPE  &to_layer_0 Q  &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T      &to_layer_0 Y     &to_layer_0 U     &to_layer_0 I     &to_layer_0 O   &to_layer_0 P   &to_layer_0 BACKSPACE
&to_layer_0 TAB      &to_layer_0 A  &to_layer_0 S  &mkp RCLK      &mkp MCLK      &mkp LCLK          &trans            &trans            &to_layer_0 H     &mkp MB1        &mkp MB3        &mkp MB2       &trans         &trans
&to_layer_0 LSHFT    &to_layer_0 Z  &to_layer_0 X  &mkp MB4       &mkp MB5       &msc SCRL_DOWN     &msc SCRL_LEFT    &msc SCRL_RIGHT   &to_layer_0 N     &to_layer_0 M   &to_layer_0 COMMA  &to_layer_0 PERIOD  &to_layer_0 SLASH  &to_layer_0 RSHFT
&trans               &trans         &trans          &trans         &trans         &trans             &trans            &trans            &msc SCRL_UP      &msc SCRL_DOWN  &trans             &trans              &trans             &trans
            >;
        };

        FUNCTION {
            display-name = "Function";
            bindings = <
&trans  &trans           &trans       &trans    &trans      &trans       &trans          &trans          &trans           &trans                &trans                 &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans  &kp F1           &kp F2       &kp F3    &kp F4      &kp F5       &trans          &trans          &trans           &kp UP                &trans                 &trans                &trans                 &trans
&trans  &kp F6           &kp F7       &kp F8    &kp F9      &kp F10      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F11               &kp F12                &trans                &trans                 &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans          &trans          &trans           &trans                &trans                 &trans                &trans                 &trans
            >;
        };

        NUM {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans        &trans        &trans       &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5        &kp N6   &kp N7   &kp N8       &kp N9        &kp N0       &trans
&trans  &trans  &trans  &trans  &trans  &kp BACKSLASH &trans  &trans  &trans        &kp NUMBER_4  &kp NUMBER_5 &kp NUMBER_6  &kp MINUS  &kp SLASH
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS  &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans        &trans        &trans       &trans        &trans     &trans
            >;
        };

        ARROW {
            display-name = "Arrow";
            bindings = <
&trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp UP    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        ADJUST {
            display-name = "Adjust";
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans      &trans          &trans
&trans       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &bootloader  &trans  &trans  &trans  &trans  &bt BT_CLR  &studio_unlock  &trans
&ws2812_wdg  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans      &trans          &bt BT_CLR_ALL
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
