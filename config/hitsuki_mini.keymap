#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
            layers = <1>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;
            label = "MKP_EXIT_AML";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESCAPE      &kp Q          &kp W          &kp E          &kp R              &kp T         &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp BACKSPACE
&mt LCTRL TAB   &kp A          &kp S          &kp D          &kp F              &kp G         &kp H                 &kp J                 &kp K                 &kp L                 &lt 5 MINUS            &kp EQUAL
&kp LEFT_SHIFT  &kp Z          &kp X          &kp C          &kp V              &kp B         &kp LEFT_BRACKET      &kp RIGHT_BRACKET     &kp N                 &kp M                 &kp COMMA             &kp PERIOD             &kp SLASH             &kp RSHFT
&kp GRAVE       &kp N1         &kp N2         &kp N3         &kp N4             &kp N5        &kp LEFT_BRACE        &kp RIGHT_BRACE       &kp N6                &kp N7                &kp N8                &kp N9                 &kp N0                &kp BACKSLASH
&kp LEFT_WIN    &kp LEFT_ALT   &lt 6 DELETE   &lt 3 SPACE    &mo 2              &mo 4         &lt 2 LANGUAGE_2      &lt 3 LANGUAGE_1      &mo 1                &lt 2 ENTER            &mt RSHIFT BACKSPACE  &kp SEMICOLON          &lt 6 SINGLE_QUOTE     &kp RIGHT_ALT
            >;
        };

        MOUSE {
            bindings = <
&to_layer_0 ESCAPE  &to_layer_0 Q  &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T    &to_layer_0 Y         &to_layer_0 U         &to_layer_0 I    &to_layer_0 O  &to_layer_0 P  &to_layer_0 BACKSPACE
&to_layer_0 TAB     &to_layer_0 A  &to_layer_0 S  &to_layer_0 D  &to_layer_0 F  &to_layer_0 G    &to_layer_0 H         &mkp_exit_AML MB1     &mkp_exit_AML MB3  &mkp_exit_AML MB2  &trans     &trans
&to_layer_0 LSHFT   &to_layer_0 Z  &to_layer_0 X  &to_layer_0 C  &to_layer_0 V  &to_layer_0 B    &msc SCRL_LEFT        &msc SCRL_RIGHT       &to_layer_0 N    &to_layer_0 M  &to_layer_0 COMMA  &to_layer_0 PERIOD  &to_layer_0 SLASH  &to_layer_0 RSHFT
&trans              &trans         &trans          &trans         &trans         &trans           &trans                &trans                &trans           &trans         &trans             &trans              &trans             &trans
&trans              &trans         &trans          &trans         &trans         &trans           &trans                &trans                &msc SCRL_UP     &msc SCRL_DOWN &mkp_exit_AML MB4  &mkp_exit_AML MB5   &trans             &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans  &kp F1           &kp F2       &kp F3    &kp F4      &kp F5       &trans          &kp UP          &trans           &trans                &trans                 &trans
&trans  &kp F6           &kp F7       &kp F8    &kp F9      &kp F10      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F11               &kp F12                &trans                 &trans                 &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans          &trans          &trans           &trans                &trans                 &trans                 &trans                 &trans
&trans  &trans           &trans       &trans    &trans      &trans       &trans          &trans          &trans           &trans                &trans                 &trans                 &trans                 &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp N1            &kp N2             &kp N3          &kp N4           &kp N5         &kp N6                &kp N7                &kp N8                &kp N9                &kp N0      &trans
&trans  &trans            &trans             &trans          &trans           &kp BACKSLASH  &trans                &kp NUMBER_4          &kp NUMBER_5          &kp NUMBER_6          &kp MINUS   &kp SLASH
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS &kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3 &kp PLUS   &kp ASTERISK  &trans
&trans  &trans            &trans             &trans          &trans           &trans         &trans                &trans                &trans                &trans                &trans      &trans     &trans        &trans
&trans  &trans            &trans             &trans          &trans           &trans         &trans                &trans                &trans                &trans                &trans      &trans     &trans        &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &bootloader   &trans        &trans        &trans        &trans          &bt BT_CLR      &studio_unlock  &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans          &trans          &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans          &trans          &bt BT_CLR_ALL
            >;
        };
    };
};
